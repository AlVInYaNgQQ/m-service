{
  "name": "m-service",
  "version": "0.0.1",
  "description": "<p align=\"center\">   <a href=\"http://nestjs.com/\" target=\"blank\"><img src=\"https://nestjs.com/img/logo-small.svg\" width=\"200\" alt=\"Nest Logo\" /></a> </p>",
  "author": "AlvinYang",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/m-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/m-service/test/jest-e2e.json",
    "db-migration-gen": "sequelize-cli migration:generate --migrations-path ./libs/database/src/migrations/ --name schema",
    "db-migration:run": "yarn sequelize-cli db:migrate --config ./libs/database/src/migration-config.js --migrations-path ./libs/database/src/migrations/",
    "db-migration:undo": "yarn sequelize-cli db:migrate:undo --config ./libs/database/src/migration-config.js --migrations-path ./libs/database/src/migrations/",
    "db-seed-gen": "sequelize-cli seed:generate --seeders-path ./libs/database/src/seeders/ --name seeder",
    "db-seed:run": "yarn sequelize-cli db:seed:all --config ./libs/database/src/migration-config.js --seeders-path ./libs/database/src/seeders/",
    "db-seed:undo": "yarn sequelize-cli db:seed:undo --config ./libs/database/src/migration-config.js--seeders-path ./libs/database/src/seeders/"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/websockets": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.10.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.10.5",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@lib/example(|/.*)$": "<rootDir>/libs/example/src/$1",
      "^libs/database(|/.*)$": "<rootDir>/libs/database/src/$1"
    }
  },
  "main": ".eslintrc.js",
  "repository": "git+https://github.com/AlVInYaNgQQ/m-service.git",
  "bugs": {
    "url": "https://github.com/AlVInYaNgQQ/m-service/issues"
  },
  "homepage": "https://github.com/AlVInYaNgQQ/m-service#readme"
}
